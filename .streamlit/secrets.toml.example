# Plantilla de secretos de Streamlit
# ---------------------------------------------------------------------
# 1. Copia este archivo como "secrets.toml" en esta misma carpeta:
#        copy secrets.toml.example secrets.toml
# 2. Edita secrets.toml y pega tu API Key de Gemini ENTRE COMILLAS
#    (obténla gratis en https://aistudio.google.com/apikey):
#
#        GEMINI_API_KEY = "tu_api_key_aqui"
#
# 3. La app la cargará automáticamente al iniciar (campo API Key precargado).
#
# NOTA: secrets.toml está excluido del repositorio por .gitignore.
#       NUNCA subas tu API Key real a git (ni a ESTE archivo .example).

GEMINI_API_KEY = "PEGA_TU_API_KEY_AQUI_ENTRE_COMILLAS"
